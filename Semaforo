<style>

article {
    width: 150px; /* Ancho fijo para contener los círculos de 120px */
    padding: 15px 0; /* Espacio arriba y abajo */
    background-color: #222; /* Un negro más suave parece más realista */
    border-radius: 20px;
    position: absolute;
    left: 25%;
    display: flex;
    flex-direction: column;
    align-items: center; /* Centra las luces horizontalmente */
    gap: 10px; /* Espacio uniforme entre luces */
}

section {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    opacity: 0.3; 
    transition: opacity 0.3s; /* Esto hace que el cambio de luz sea suave */
}

/* Clases de estado (se aplicarán por JS) */
.rojo { background-color: red; }
.amarillo { background-color: yellow; }
.verde { background-color: green; }
</style>
<body>
    <article>
    <section class="rojo" id="1"></section>
    <section class="amarillo" id="2"></section>
    <section class="verde" id="3"></section>
    </article>
<!-- Code injected by live-server -->
<script>
	// <![CDATA[  <-- For SVG support
	if ('WebSocket' in window) {
		(function () {
			function refreshCSS() {
				var sheets = [].slice.call(document.getElementsByTagName("link"));
				var head = document.getElementsByTagName("head")[0];
				for (var i = 0; i < sheets.length; ++i) {
					var elem = sheets[i];
					var parent = elem.parentElement || head;
