<script>
const luces = {
    rojo: document.getElementById("1"),
    amarillo: document.getElementById("2"),
    verde: document.getElementById("3")
};

function apagarTodo() {
    luces.rojo.style.opacity = 0.3;
    luces.amarillo.style.opacity = 0.3;
    luces.verde.style.opacity = 0.3;
}

function iniciarSemaforo() {
    // 1. Rojo
    apagarTodo();
    luces.rojo.style.opacity = 1;
    
    setTimeout(() => {
        // 2. Verde (después de 5s)
        apagarTodo();
        luces.verde.style.opacity = 1;
        
        setTimeout(() => {
            // 3. Amarillo (después de 5s)
            apagarTodo();
            luces.amarillo.style.opacity = 1;
            
            setTimeout(() => {
                // 4. Reiniciar ciclo (después de 2s)
                iniciarSemaforo();
            }, 2000);
            
        }, 5000);
        
    }, 5000);
}

iniciarSemaforo();



